<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.srt-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/user/srt-watch/.venv/bin/python</string>
        <string>/Users/user/srt-watch/watch.py</string>
    </array>
    <key>StartInterval</key>
    <integer>10</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>/Users/user/srt-watch</string>
    <key>StandardOutPath</key>
    <string>/Users/user/srt-watch/out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/srt-watch/err.log</string>
</dict>
</plist>
